{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run test)",
      "Bash(./mvnw spring-boot:run)",
      "Bash(./mvnw test)",
      "Bash(./mvnw clean package)",
      "Bash(docker-compose up)",
      "Bash(docker-compose down)"
    ],
    "deny": [
      "Bash(sudo rm*)",
      "Bash(sudo apt*)",
      "Bash(sudo yum*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-bash-file-edit.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-add-wrong-cwd.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-hardcoded-hex.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/post-lint-fix.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "a11y-audit@claude-code-skills": true
  }
}
